{
  "name": "code-intel-platform",
  "version": "1.0.10",
  "private": true,
  "license": "MIT",
  "files": [],
  "workspaces": [
    "code-intel/shared",
    "code-intel/core",
    "code-intel/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:product": "npm run build --workspace=code-intel/shared && npm run build --workspace=code-intel/web && npm run build --workspace=code-intel/core",
    "clean:product": "npm run clean --workspace=code-intel/shared --if-present && npm run clean --workspace=code-intel/web --if-present && npm run clean --workspace=code-intel/core --if-present && rm -rf code-intel/core/dist-tests code-intel/shared/tsconfig.tsbuildinfo dist/runtime-bundles",
    "verify:release-metadata": "node scripts/verify-release-metadata.mjs",
    "verify:runtime-bundle-integrity": "node scripts/verify-runtime-bundle-integrity.mjs",
    "verify:npm-install": "node scripts/verify-npm-install.mjs",
    "verify:upgrade-from-1.0.10": "node scripts/verify-upgrade-from-1.0.10.mjs",
    "verify:packaged-smoke-matrix": "node scripts/verify-packaged-smoke-matrix.mjs",
    "verify:build-ordering": "node scripts/verify-build-ordering.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint code-intel/*/src/**/*.ts",
    "format": "prettier --write \"code-intel/*/src/**/*.ts\"",
    "test": "npm run test --workspaces --if-present",
    "eval": "node eval/run-eval.mjs",
    "eval:json": "node eval/run-eval.mjs --json",
    "eval:multi": "node eval/run-eval-multi.mjs",
    "eval:all": "node eval/run-eval.mjs --json && node eval/run-eval-multi.mjs --json && node eval/run-eval-langs.mjs --json",
    "eval:langs": "node eval/run-eval-langs.mjs --json",
    "eval:summary": "node eval/summarize.mjs",
    "bench": "node eval/run-agent-bench.mjs --json",
    "bench:mcp": "node eval/run-mcp-bench.mjs --json",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "verify:runtime-distribution": "node scripts/verify-runtime-distribution.mjs",
    "verify:docker-publish": "node scripts/verify-docker-publish.mjs",
    "distribution:manifest": "node scripts/distribution/runtime-manifest.mjs --json",
    "distribution:manifest:validate": "node scripts/distribution/runtime-manifest.mjs --validate",
    "distribution:bundle": "node scripts/distribution/build-runtime-bundle.mjs",
    "distribution:install": "node scripts/distribution/install/install-runtime.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@vohongtho.infotech/code-intel": "^1.0.10"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0",
    "node-domexception": "^2.0.2",
    "qs": "^6.15.3",
    "tar": "^7.5.19",
    "hono": "4.13.0",
    "brace-expansion": "5.0.9",
    "esbuild": "^0.28.1",
    "protobufjs": "^8.6.6",
    "@grpc/grpc-js": "^1.14.4",
    "@modelcontextprotocol/sdk": {
      "hono": "4.13.0",
      "fast-uri": "3.1.7",
      "ip-address": "10.4.0"
    },
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.7",
    "ip-address": "10.4.0",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "tsup": {
      "esbuild": "^0.28.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.24.3": true,
    "tree-sitter-c": true,
    "tree-sitter-cpp@0.23.4": true,
    "tree-sitter-cli@0.23.2": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-java@0.23.5": true,
    "tree-sitter-html@0.23.2": true,
    "tree-sitter-dart@1.0.0": true,
    "tree-sitter-ruby@0.23.1": true,
    "tree-sitter-swift@0.7.1": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter-kotlin@0.3.8": true,
    "@ladybugdb/core@0.18.3": true,
    "tree-sitter-c-sharp": true,
    "tree-sitter-go": true,
    "tree-sitter-php": true,
    "tree-sitter-python": true,
    "tree-sitter-rust": true
  }
}
