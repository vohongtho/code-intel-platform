{
  "name": "code-intel-platform",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "files": [],
  "workspaces": [
    "code-intel/shared",
    "code-intel/core",
    "code-intel/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint code-intel/*/src/**/*.ts",
    "format": "prettier --write \"code-intel/*/src/**/*.ts\"",
    "test": "npm run test --workspaces --if-present",
    "eval": "node eval/run-eval.mjs",
    "eval:json": "node eval/run-eval.mjs --json",
    "eval:multi": "node eval/run-eval-multi.mjs",
    "eval:all": "node eval/run-eval.mjs --json && node eval/run-eval-multi.mjs --json && node eval/run-eval-langs.mjs --json",
    "eval:langs": "node eval/run-eval-langs.mjs --json",
    "eval:summary": "node eval/summarize.mjs",
    "bench": "node eval/run-agent-bench.mjs --json",
    "bench:mcp": "node eval/run-mcp-bench.mjs --json"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@vohongtho.infotech/code-intel": "^1.0.4"
  },
  "overrides": {
    "sharp": "^0.33.0",
    "onnxruntime-node": "^1.25.1",
    "node-domexception": "^2.0.2",
    "global-agent": "^4.1.3",
    "qs": "^6.15.3",
    "tar": "^7.5.19",
    "hono": "^4.12.27",
    "brace-expansion": "^5.0.7",
    "esbuild": "^0.28.1",
    "protobufjs": "^8.6.6",
    "@grpc/grpc-js": "^1.14.4",
    "@modelcontextprotocol/sdk": {
      "hono": "^4.12.27"
    },
    "@hono/node-server": {
      "hono": "^4.12.27"
    },
    "tsup": {
      "esbuild": "^0.28.1"
    }
  }
}
