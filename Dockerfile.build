FROM node:22-bookworm-slim

WORKDIR /app

# Copy package files first for layer caching
COPY package.json package-lock.json ./
COPY code-intel/shared/package.json ./code-intel/shared/
COPY code-intel/core/package.json ./code-intel/core/
COPY code-intel/web/package.json ./code-intel/web/

# Install workspace dependencies
RUN npm install

# Copy full source
COPY . .

# Authoritative product build (shared -> web -> core). Previously this built
# Core before Web, which only "worked" because Core's build silently skips
# copying dist/web/ when it doesn't exist yet — see copy-grammars.mjs.
RUN npm run build:product

# Run tests
RUN npm test --workspace=code-intel/core
